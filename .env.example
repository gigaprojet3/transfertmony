# --- Base de données ---
DATABASE_URL="postgresql://transfertmony:motdepasse@localhost:5432/transfertmony?schema=public"

# --- Application ---
APP_URL="http://localhost:3000"
# 32 caractères minimum. Générer : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""
# Secret du cron de réconciliation (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
# Marge de change appliquée entre devises différentes (en %)
FX_MARGIN_PERCENT="1"

# --- SasPay ---
SASPAY_BASE_URL="https://api.saspay.example"
SASPAY_API_KEY=""
SASPAY_SECRET_KEY=""
# Secret de signature des webhooks (par défaut : SASPAY_SECRET_KEY)
SASPAY_WEBHOOK_SECRET=""
# À ajuster selon la documentation SasPay
SASPAY_COLLECT_PATH="/v1/collections"
SASPAY_PAYOUT_PATH="/v1/payouts"
SASPAY_STATUS_PATH="/v1/transactions"
SASPAY_WEBHOOK_SIGNATURE_HEADER="x-saspay-signature"
SASPAY_WEBHOOK_TIMESTAMP_HEADER="x-saspay-timestamp"
SASPAY_TIMEOUT_MS="20000"
